# =============================================================================
# .env.example - GIÁ TRỊ MẪU CHẠY ĐƯỢC NGAY
# Sao chép: cp .env.example .env
# TUYỆT ĐỐI KHÔNG commit file .env (đã bị .gitignore chặn).
# Khi triển khai thật: đổi JWT_SECRET và DB_PASSWORD sang giá trị riêng của bạn.
# =============================================================================

# ---------- Application ----------
NODE_ENV=production
PORT=3000
API_PORT=3000
WEB_PORT=5173
API_PREFIX=/api

# ---------- Database (PostgreSQL 16) ----------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mekong_crm_l4
DB_USER=postgres
DB_PASSWORD=postgres
# Chỉ dùng khi chạy backend NGOÀI Docker. Trong Docker, DATABASE_URL được ghi đè
# bằng tên service "postgres" trong docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mekong_crm_l4?schema=public

# ---------- JWT Authentication ----------
# >= 32 ký tự. Sinh bản thật bằng: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_key_mekong_mobile_2026
JWT_EXPIRES_IN=8h

# ---------- CORS & hai URL độc lập ----------
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# URL API mà trình duyệt dùng để gọi (nhúng vào bundle Vite lúc build)
PUBLIC_API_URL=http://localhost:3000
